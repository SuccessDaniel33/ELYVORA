{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elyvora",
  "main": "src/index.js",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "elyvora-core",
      "database_id": "75242196-af60-40d0-9011-3756593ea9aa",
      "migrations_dir": "migrations"
    }
  ]
}
